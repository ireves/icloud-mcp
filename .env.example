# iCloud account email used for both IMAP and CalDAV
ICLOUD_EMAIL=you@icloud.com

# App-specific password generated at appleid.apple.com — NOT your main Apple ID password
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Sign-in (OAuth) ---
# The MCP server verifies access tokens issued by an outside sign-in service
# (Auth0, Clerk, WorkOS, Okta, Keycloak — anything with standard OpenID Connect
# discovery). It never issues tokens itself.

# The sign-in service's base URL, exactly as it appears in the "iss" claim.
OAUTH_ISSUER=https://your-tenant.example.auth0.com

# This server's own identifier, registered as an API/audience in that service.
# Tokens must name it, which stops a token meant for some other app being reused
# here. Use the deployed MCP endpoint URL.
OAUTH_AUDIENCE=https://icloud-mcp-yourname.vercel.app/api/mcp

# Optional. Scope an access token must carry. Defaults to "mcp:access" when
# OAUTH_ISSUER is set; set to an empty value to skip the scope check entirely.
OAUTH_REQUIRED_SCOPE=

# Optional. Only needed if the sign-in service publishes its signing keys
# somewhere other than <issuer>/.well-known/jwks.json.
OAUTH_JWKS_URI=

# Optional. Overrides the public URL used in the discovery document. Normally
# worked out from the incoming request, so leave unset.
PUBLIC_BASE_URL=

# --- Legacy shared secret (optional, being retired) ---
# The original single bearer token. While this is set it is still accepted
# alongside OAuth, so an existing connector keeps working. Unset it once every
# client has moved over.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=

# Optional. When unset (the default), moving a message into a Trash or Junk
# folder is blocked by the server regardless of what the agent requests.
# Set to the exact string "true" to lift this restriction. There is no
# per-call override — this is an operator-only setting.
ALLOW_TRASH_JUNK_MOVES=

# Upstash Redis (used for durable move-undo tracking). Provided automatically,
# under these names, when you connect the Upstash integration to this project
# in Vercel's Storage tab; for local development, create a free database at
# https://console.upstash.com and copy its REST URL and token here.
KV_REST_API_URL=
KV_REST_API_TOKEN=
