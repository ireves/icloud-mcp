# iCloud account email used for both IMAP and CalDAV
ICLOUD_EMAIL=you@icloud.com

# App-specific password generated at appleid.apple.com — NOT your main Apple ID password
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---- Sign-in ----
# This deployment is its own OAuth 2.1 authorization server, so there is no
# provider to configure: no client id, no secret, no callback URL.

# The address this server will finally live at. Scheme and host only; any path
# is ignored. Set it before registering a passkey, because a passkey is tied to
# the hostname and clients reject a server that names itself differently from
# the address they were given. Locally this is http://localhost:3000.
MCP_PUBLIC_URL=

# Signs the tokens this server issues. Generate once with:
#   openssl rand -base64 48
# Changing it signs you out and invalidates every connector.
BETTER_AUTH_SECRET=

# Your email address. It labels the single owner account; nothing is sent to it.
MCP_OWNER_EMAIL=

# Lets you register the first passkey, once. Generate one with:
#   openssl rand -hex 24
# It stops working the moment a passkey exists, so there is nothing to rotate.
MCP_SETUP_CODE=

# ---- Sign-in database ----
# Where the accounts, passkeys, signing keys and issued tokens live. The Vercel
# Supabase integration sets POSTGRES_URL for you; set DATABASE_URL by hand only
# if you are not using that integration. Either way use the POOLER connection
# string (port 6543), not the direct one: the direct host answers only over
# IPv6, and a Vercel function has none.
DATABASE_URL=

# Optional. When set, the daily keep-alive route answers only Vercel's own
# scheduled request, which sends it as a bearer token. Generate it like the
# others: openssl rand -hex 24
CRON_SECRET=

# Optional. When unset (the default), moving a message into a Trash or Junk
# folder is blocked by the server regardless of what the agent requests.
# Set to the exact string "true" to lift this restriction. There is no
# per-call override — this is an operator-only setting.
ALLOW_TRASH_JUNK_MOVES=

# Optional. A comma-separated allowlist of folders a message may be moved
# into, e.g. Archive,Receipts,Newsletters,Work/Clients. INBOX is always
# allowed as a destination so recovery and undo keep working. When this is
# unset, any folder other than Trash/Junk is allowed, which is the less safe
# choice. There is no per-call override — this is an operator-only setting.
ALLOWED_MOVE_DESTINATIONS=

# Optional. Comma-separated folders a message may never be moved into, e.g.
# Receipts,Work/Clients. Every other folder is allowed, including new ones.
# Trash, Junk, Sent and Drafts are always blocked and need not be listed. An
# entry that matches no real folder refuses every move until it is corrected,
# so a typo is noticed instead of leaving a folder unprotected.
BLOCKED_MOVE_DESTINATIONS=

# Notion integration secret for the "Email Sorting Exceptions" database, which
# holds the operator's standing rules about where mail from a given sender
# belongs. Create an internal integration with ONLY the "Read content"
# capability, then share the exceptions database with it. When this is unset
# the feature is off: list_exceptions reports that it is not configured, and
# no exception is enforced on moves.
NOTION_EXCEPTIONS_TOKEN=

# Optional. The data source queried for those rules. Defaults to
# f2ebf247-9368-498f-86a9-3341260874e1, which is the existing database.
NOTION_EXCEPTIONS_DATA_SOURCE_ID=

# Supabase (used for durable move-undo tracking and mail scan progress).
# Provided automatically when you connect the Supabase integration to this
# project in Vercel's Storage tab; for local development, copy them from your
# project's Settings > API Keys page in the Supabase dashboard.
#
# Set ONE of the two keys below. A project created through Vercel gets
# SUPABASE_SECRET_KEY (an sb_secret_... key); a project set up by hand, and
# anything older, uses SUPABASE_SERVICE_ROLE_KEY. Either works, and
# SUPABASE_SECRET_KEY wins if both are set.
#
# Both bypass row level security and must stay server-side. Never put either
# in a client, a browser, or a public repository.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
