# iCloud account email used for both IMAP and CalDAV
ICLOUD_EMAIL=you@icloud.com

# App-specific password generated at appleid.apple.com — NOT your main Apple ID password
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# OAuth. The base URL of the authorization server that signs people in, e.g.
# https://your-tenant.eu.auth0.com — no trailing slash.
OAUTH_ISSUER=

# The canonical URL of this MCP server. Tokens are only accepted if they were
# issued for this audience, which stops a token minted for some other API
# behind the same issuer being replayed here.
OAUTH_AUDIENCE=https://your-deployment.vercel.app/api/mcp

# Optional. Space-separated scopes a token must carry, e.g. "icloud:read
# icloud:write". Leave blank to accept any valid token for the audience above.
OAUTH_REQUIRED_SCOPE=

# Optional. The signing key address is normally discovered from the issuer
# automatically. Only set this if your provider publishes neither an OAuth nor
# an OpenID discovery document.
OAUTH_JWKS_URI=

# Optional fallback shared secret, for scripts and scheduled runs that cannot
# complete an interactive sign-in. Sent in the same Authorization: Bearer
# header. Leave unset to accept OAuth only.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=

# Optional. When unset (the default), moving a message into a Trash or Junk
# folder is blocked by the server regardless of what the agent requests.
# Set to the exact string "true" to lift this restriction. There is no
# per-call override — this is an operator-only setting.
ALLOW_TRASH_JUNK_MOVES=

# Notion integration secret for the "Email Sorting Exceptions" database, which
# holds the operator's standing rules about where mail from a given sender
# belongs. Create an internal integration with ONLY the "Read content"
# capability, then share the exceptions database with it. When this is unset
# the feature is off: list_exceptions reports that it is not configured, and
# no exception is enforced on moves.
NOTION_EXCEPTIONS_TOKEN=

# Optional. The data source queried for those rules. Defaults to
# f2ebf247-9368-498f-86a9-3341260874e1, which is the existing database.
NOTION_EXCEPTIONS_DATA_SOURCE_ID=

# Upstash Redis (used for durable move-undo tracking). Provided automatically,
# under these names, when you connect the Upstash integration to this project
# in Vercel's Storage tab; for local development, create a free database at
# https://console.upstash.com and copy its REST URL and token here.
KV_REST_API_URL=
KV_REST_API_TOKEN=
