{
  "name": "icloud-mcp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "auth:migrate": "auth migrate --config lib/auth-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:imap": "tsx scripts/test-imap.ts",
    "test:caldav": "tsx scripts/test-caldav.ts",
    "migrate:storage": "tsx scripts/migrate-upstash-to-supabase.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.5",
    "@better-auth/mcp": "1.7.5",
    "@better-auth/oauth-provider": "1.7.5",
    "@better-auth/passkey": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@supabase/supabase-js": "^2.116.0",
    "better-auth": "1.7.5",
    "html-to-text": "^9.0.5",
    "ical.js": "^2.1.0",
    "imapflow": "^1.0.171",
    "jose": "^6.2.12",
    "mailparser": "^3.7.1",
    "mcp-handler": "^1.1.0",
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdav": "^2.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@upstash/redis": "^1.38.4",
    "auth": "1.7.5",
    "dotenv": "^16.4.5",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "undici": "7.29.1",
    "ajv": "8.20.0",
    "postcss": "^8.5.23"
  },
  "description": "Remote MCP server for iCloud mail, calendar and reminders, hosted on Vercel, acting as its own OAuth 2.1 authorization server with passkey sign-in."
}
